# Copie para .env e preencha. O .env real nunca entra no repositório.

DATABASE_URL=postgres://leilao:senha@localhost:5433/leilao
REDIS_URL=redis://localhost:6380
PORT=4500

# Origem pública do site. Alimenta canonical, Open Graph, JSON-LD e o sitemap.
SITE_URL=http://localhost:4500

# Sessão: janela de ociosidade (desliza a cada uso) e teto absoluto.
APP_SESSAO_OCIOSA_HORAS=12
APP_SESSAO_HORAS=720

# Encerramento por ausência SEM verificar na origem. Medido: fecharia 3 em cada
# 4 lotes vivos. Não ligue isto sem ler a seção do README.
ENCERRAR_POR_AUSENCIA=0

# Verificação na origem: quantos lotes por ciclo e de quanto em quanto tempo.
VERIFICAR_POR_CICLO=300
VERIFICAR_INTERVALO_MS=300000

# Notificação do navegador: gere com `npx web-push generate-vapid-keys`
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Portão de senha. Se APP_SENHA ficar vazio, o portão não liga (uso local).
APP_USUARIO=
APP_SENHA=
APP_SESSAO_SEGREDO=

# Conta sem permissão de coleta
APP_USUARIO_COMUM=
APP_SENHA_COMUM=

# ---------------------------------------------------------------------------
# Provedor de identidade (OIDC / Keycloak)
#
# Sem OIDC_ISSUER o provedor fica DESLIGADO e só o portão de senha funciona.
# O realm é importado de infra/keycloak/realm-radar.json quando o container sobe.
# Painel do Keycloak: http://localhost:8081 (KC_ADMIN_USER / KC_ADMIN_PASS)
# ---------------------------------------------------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=radar-web
# Client público com PKCE não usa segredo; preencha só se trocar para confidencial.
OIDC_CLIENT_SECRET=
# Role do realm que concede papel de admin aqui. Sem ela, a conta entra como comum.
OIDC_ROLE_ADMIN=radar-admin

KC_ADMIN_USER=admin
KC_ADMIN_PASS=admin

# Antibot (etapa 1 apenas implementa fundação; server.ts ainda não integra hooks).
# Local sem configuração permanece off e não abre conexão Redis. Em produção
# ANTIBOT_MODE é obrigatório; off exige autorização explícita ANTIBOT_ALLOW_OFF=1.
# Ativo usa cliente Redis dedicado; URL prefere ANTIBOT_REDIS_URL, depois REDIS_URL.
# ANTIBOT_MODE=off|shadow|enforce
# ANTIBOT_ALLOW_OFF=1
# ANTIBOT_REDIS_URL=redis://localhost:6380
# Defaults: search/detail/vitrine/login 30/60s, mapa 12/60s,
# cadastro/espera 10/3600s. Máximo configurável 1..10000, janela 1000..3600000ms.
# ANTIBOT_SEARCH_MAX=30
# ANTIBOT_SEARCH_WINDOW_MS=60000
# ANTIBOT_DETAIL_MAX=30
# ANTIBOT_DETAIL_WINDOW_MS=60000
# ANTIBOT_MAPA_MAX=12
# ANTIBOT_MAPA_WINDOW_MS=60000
# ANTIBOT_VITRINE_MAX=30
# ANTIBOT_VITRINE_WINDOW_MS=60000
# ANTIBOT_CADASTRO_MAX=10
# ANTIBOT_CADASTRO_WINDOW_MS=3600000
# ANTIBOT_ESPERA_MAX=10
# ANTIBOT_ESPERA_WINDOW_MS=3600000
# ANTIBOT_LOGIN_MAX=60
# ANTIBOT_LOGIN_WINDOW_MS=60000
# Redis real para teste opt-in, namespace único obrigatório no teste:
# ANTIBOT_TEST_REDIS_URL=redis://localhost:6380

# Turnstile challenge (módulo backend etapa 3; integração HTTP será posterior).
# Local default off. Produção exige ANTIBOT_CHALLENGE_MODE; off exige autorização.
# ANTIBOT_CHALLENGE_MODE=off|enforce
# ANTIBOT_CHALLENGE_ALLOW_OFF=1
# TURNSTILE_SITE_KEY=your-public-site-key
# TURNSTILE_SECRET_KEY=your-server-only-secret
# Hostnames de validação, independentes do Host recebido na requisição:
# TURNSTILE_HOSTNAMES=radardeleiloes.app.br,www.radardeleiloes.app.br

# Future reverse-proxy trust only: keep unset/default false until the operator
# verifies the origin cannot be reached directly and the proxy overwrites
# forwarded headers. In production, nonempty CIDRs require acknowledgement;
# that acknowledgement does not itself prove origin closure.
# ANTIBOT_TRUST_PROXY_CIDRS=
# ANTIBOT_ORIGIN_PROTECTION_CONFIRMED=
