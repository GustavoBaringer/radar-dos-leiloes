# TEMPLATE INERTE — não habilitar. Requer TLS e trusted-cloudflare-ips.conf
# provisionados/verificados pelo operador; não incluídos neste repositório.
server {
    listen 443 ssl;
    server_name radardeleiloes.app.br www.radardeleiloes.app.br;

    ssl_certificate     /etc/letsencrypt/live/radardeleiloes.app.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/radardeleiloes.app.br/privkey.pem;

    # Include obrigatório. O operador deve verificar a origem e atualizar a lista.
    include /etc/nginx/operator/trusted-cloudflare-ips.conf;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    location / {
        proxy_pass http://127.0.0.1:4500;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Sobrescreve qualquer XFF do cliente; nunca append/confiar nele.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Sem listener HTTP neste exemplo: redirecionamento/ACME devem ser decididos
# pelo operador junto com DNS e estratégia de origem, não ativados implicitamente.
