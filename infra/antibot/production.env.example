# TEMPLATE INERTE — nunca usar como env real/copy-paste. Configuração incompleta
# intencionalmente: modos enforce com credenciais/ACK vazios devem falhar.
NODE_ENV=production
ANTIBOT_MODE=enforce
ANTIBOT_ALLOW_OFF=
ANTIBOT_CHALLENGE_MODE=enforce
ANTIBOT_CHALLENGE_ALLOW_OFF=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=radardeleiloes.app.br,www.radardeleiloes.app.br

# URL autenticada para Redis antibot privado na porta loopback 6381; preencher
# apenas por provisionamento seguro. Vazio é inválido e impede fallback para 6380.
ANTIBOT_REDIS_URL=

# Proxy futuro intencionalmente loopback. Não habilitar confiança em proxy até
# validar CIDRs estreitos e comprovar proteção da origem; ACK não é prova.
ANTIBOT_TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128
ANTIBOT_ORIGIN_PROTECTION_CONFIRMED=
