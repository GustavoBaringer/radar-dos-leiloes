# Template only. Populate secrets in Dokploy's secret environment; do not use
# this file as a live env file. URL credentials must be URL-safe (no reserved
# URL characters); the compose file intentionally does not assume URL encoding.
PG_INIT_ADMIN_USER=radar_bootstrap
PG_INIT_ADMIN_PASSWORD=
KEYCLOAK_VERSION=
RADAR_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
REDIS_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
OIDC_CLIENT_SECRET=
APP_SESSAO_SEGREDO=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=radardeleiloes.app.br

# Fill with the actual narrow Dokploy/Traefik proxy source CIDR(s), then
# independently verify origin protection and forwarded-header spoofing.
ANTIBOT_TRUST_PROXY_CIDRS=
ANTIBOT_ORIGIN_PROTECTION_CONFIRMED=
