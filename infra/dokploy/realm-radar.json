{
  "realm": "radar",
  "enabled": true,
  "displayName": "Radar de Leilões",
  "loginTheme": "keycloak",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "maxFailureWaitSeconds": 900,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "passwordPolicy": "length(10) and notUsername(undefined) and notEmail(undefined)",
  "roles": {
    "realm": [
      { "name": "radar-admin", "description": "Pode disparar coleta e ver telemetria" },
      { "name": "radar-comum", "description": "Busca e alertas próprios" }
    ]
  },
  "clients": [
    {
      "clientId": "radar-web",
      "name": "Radar de Leilões (web)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://radardeleiloes.app.br/*"
      },
      "redirectUris": ["https://radardeleiloes.app.br/auth/callback"],
      "webOrigins": ["https://radardeleiloes.app.br"],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "realm roles no id_token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "waitIncrementSeconds": 60
}
