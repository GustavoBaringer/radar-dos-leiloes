{
  "name": "leilao-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env node_modules/.bin/tsx watch src/server.ts",
    "start": "node --env-file=.env node_modules/.bin/tsx src/server.ts",
    "worker": "node --env-file=.env node_modules/.bin/tsx src/queue/worker.ts",
    "migrate": "tsx scripts/migrate.ts",
    "collect": "node --env-file=.env node_modules/.bin/tsx scripts/collect.ts",
    "build:backend": "node scripts/build-backend.mjs",
    "start:compiled": "node --env-file=.env dist/src/server.js",
    "test:compiled": "node scripts/run-compiled-tests.mjs",
    "test:antibot": "node --import tsx scripts/teste-antibot.ts",
    "test:antibot:data": "node --import tsx --test scripts/teste-antibot-data.ts",
    "test:antibot:resources": "node --import tsx --test scripts/teste-antibot-resources.ts",
    "test:antibot:images": "node --import tsx --test scripts/teste-antibot-images.ts",
    "test:antibot:ws": "node --import tsx --test scripts/teste-antibot-ws.ts",
    "test:antibot:redis": "node --import tsx scripts/teste-antibot-redis.ts",
    "test:antibot:ws:redis": "node --import tsx scripts/teste-antibot-ws-redis.ts",
    "test:antibot:account-context": "node --import tsx --test scripts/teste-antibot-account-context.ts",
    "test:antibot:frontend-state": "node --import tsx --test scripts/teste-antibot-frontend-state.ts",
    "test:antibot:integration": "node --import tsx --test scripts/teste-antibot-integration.ts",
    "test:antibot:challenge": "node --import tsx --test scripts/teste-antibot-challenge.ts",
    "test:antibot:challenge:integration": "node --import tsx --test scripts/teste-antibot-challenge-integration.ts",
    "test:antibot:operations": "node --import tsx --test scripts/teste-antibot-operations.ts",
    "test:security-deps": "node --import tsx scripts/teste-dependencias-seguranca.ts",
    "typecheck": "tsc --noEmit",
    "test:isolated": "node scripts/run-safe-tests.mjs",
    "test:coverage": "node scripts/run-safe-tests.mjs --coverage"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.5",
    "@fastify/websocket": "^11.0.2",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "bullmq": "^5.34.10",
    "cheerio": "^1.0.0",
    "fastify": "5.12.5",
    "ioredis": "^5.4.2",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "playwright-core": "^1.63.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "undici": "^7.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
