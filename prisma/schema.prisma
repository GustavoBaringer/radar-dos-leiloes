generator client {
  provider        = "prisma-client"
  output          = "../src/infra/database/generated"
  importFileExtension = "js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model alert_hits {
  id         BigInt   @id @default(autoincrement())
  alert_id   BigInt
  lot_id     BigInt
  seen       Boolean  @default(false)
  notified   String[] @default([])
  created_at DateTime @default(now()) @db.Timestamptz(6)
  alerts     alerts   @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lots       lots     @relation(fields: [lot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([alert_id, lot_id])
  @@index([seen, created_at(sort: Desc)], map: "alert_hits_novos")
}

model alerts {
  id          BigInt       @id @default(autoincrement())
  label       String
  q           String?
  filters     Json         @default("{}")
  channels    String[]     @default(["sino"])
  email       String?
  enabled     Boolean      @default(true)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  last_run_at DateTime?    @db.Timestamptz(6)
  owner_id    BigInt?
  alert_hits  alert_hits[]
  users       users?       @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([owner_id], map: "alerts_owner_idx", where: raw("enabled"))
}

model auctioneers {
  id             BigInt   @id @default(autoincrement())
  registry       String
  external_id    String
  name           String
  matricula      String?
  junta          String?
  uf             String?
  situacao       String?
  domain         String?
  domain_origin  String?
  blocked        Boolean  @default(false)
  collected_at   DateTime @default(now()) @db.Timestamptz(6)
  uf_junta       String?
  ano_posse      String?
  credenciamento String?
  associado      Boolean?
  nivel          String?
  dominio_leilao String?

  @@unique([registry, external_id])
  @@index([dominio_leilao], map: "auctioneers_dom_leilao")
  @@index([domain], map: "auctioneers_domain")
  @@index([situacao], map: "auctioneers_situacao")
  @@index([uf_junta], map: "auctioneers_uf")
}

model bid_history {
  id          BigInt   @id @default(autoincrement())
  lot_id      BigInt
  bid         Decimal  @db.Decimal(14, 2)
  observed_at DateTime @default(now()) @db.Timestamptz(6)
  lots        lots     @relation(fields: [lot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lot_id, observed_at(sort: Desc)], map: "bid_history_lot")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cadastros {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                    String
  cpf_cnpj                String   @unique(map: "cadastros_cpf_cnpj_uk")
  tipo_documento          String
  email                   String   @unique(map: "cadastros_email_uk")
  celular                 String
  status                  String   @default("pendente_pagamento")
  plano                   String   @default("mensal")
  valor_mensal            Decimal  @default(69.90) @db.Decimal(10, 2)
  asaas_customer_id       String?  @unique
  asaas_subscription_id   String?  @unique
  consentimento_termos_em DateTime @db.Timestamptz(6)
  consentimento_versao    String
  consentimento_texto     String
  consentimento_ip        String?
  consentimento_marketing Boolean  @default(false)
  origem                  String?
  criado_em               DateTime @default(now()) @db.Timestamptz(6)
  atualizado_em           DateTime @default(now()) @db.Timestamptz(6)

  @@index([status])
  onboarding_registration onboarding_registrations?
  checkout_attempts      onboarding_checkout_attempts[]
  initial_payment        onboarding_initial_payments?
  activation_intent      onboarding_activation_intents?
  identity_binding       onboarding_identity_bindings?
}

model onboarding_registrations {
  cadastro_id       String      @id @db.Uuid
  email_verified_at DateTime?   @db.Timestamptz(6)
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  cadastro          cadastros   @relation(fields: [cadastro_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_registrations_cadastro_fk")
  invitations       onboarding_invitations[]
}

model onboarding_invitations {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cadastro_id          String                    @db.Uuid
  purpose              String
  token_hash           String                    @unique(map: "onboarding_invitations_token_hash_uk")
  expires_at           DateTime                  @db.Timestamptz(6)
  consumed_at          DateTime?                 @db.Timestamptz(6)
  created_at           DateTime                  @default(now()) @db.Timestamptz(6)
  registration         onboarding_registrations @relation(fields: [cadastro_id], references: [cadastro_id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_invitations_registration_fk")
  email_outbox         onboarding_email_outbox?
  checkout_attempt     onboarding_checkout_attempts?
  activation_for       onboarding_initial_payments? @relation("onboarding_initial_payment_activation")
  activation_intent    onboarding_activation_intents?

  @@index([cadastro_id, purpose], map: "onboarding_invitations_registration_purpose_idx")
  @@index([expires_at], map: "onboarding_invitations_expires_idx")
}

model onboarding_email_outbox {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitation_id    String                 @unique(map: "onboarding_email_outbox_invitation_uk") @db.Uuid
  encrypted_token  Bytes?                 @db.ByteA
  available_at     DateTime               @default(now()) @db.Timestamptz(6)
  attempts         Int                    @default(0)
  lease_until      DateTime?              @db.Timestamptz(6)
  sent_at          DateTime?              @db.Timestamptz(6)
  last_error_sanitized String?
  created_at       DateTime               @default(now()) @db.Timestamptz(6)
  invitation       onboarding_invitations @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_email_outbox_invitation_fk")

  @@index([available_at, lease_until], map: "onboarding_email_outbox_pending_idx", where: raw("(sent_at IS NULL)"))
}

model onboarding_checkout_attempts {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cadastro_id      String                 @db.Uuid
  invitation_id    String                 @unique(map: "onboarding_checkout_attempts_invitation_uk") @db.Uuid
  state            String                 @default("requested")
  price_cents      Int                    @default(6990)
  currency         String                 @default("BRL")
  billing_type     String                 @default("CREDIT_CARD")
  cycle            String                 @default("MONTHLY")
  next_due_date    DateTime               @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'America/Sao_Paulo'::text))::date")) @db.Date
  checkout_id      String?                @unique(map: "onboarding_checkout_attempts_checkout_id_uk")
  checkout_link    String?
  email_sent_at    DateTime?               @db.Timestamptz(6)
  email_attempts   Int                     @default(0)
  email_lease_until DateTime?               @db.Timestamptz(6)
  email_next_attempt_at DateTime?           @db.Timestamptz(6)
  email_error_code String?
  safe_error_code  String?
  created_at       DateTime               @default(now()) @db.Timestamptz(6)
  updated_at       DateTime               @default(now()) @db.Timestamptz(6)
  reconciliation_lease_token String?      @db.Uuid
  reconciliation_lease_until DateTime?    @db.Timestamptz(6)
  cadastro         cadastros              @relation(fields: [cadastro_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_checkout_attempts_cadastro_fk")
  invitation       onboarding_invitations @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_checkout_attempts_invitation_fk")
  initial_payment  onboarding_initial_payments?

  @@unique([cadastro_id], map: "onboarding_checkout_attempts_active_cadastro_uk", where: raw("(state = ANY (ARRAY['requested'::text, 'dispatching'::text, 'created'::text, 'unknown'::text]))"))
  @@index([state, created_at], map: "onboarding_checkout_attempts_queue_idx", where: raw("(state = 'requested'::text)"))
  @@index([email_next_attempt_at, email_lease_until], map: "onboarding_checkout_attempts_email_pending_idx", where: raw("((state = 'created'::text) AND (checkout_link IS NOT NULL) AND (email_sent_at IS NULL))"))
}

/// Inbox for authenticated Asaas events; resource contains only the parser projection.
model asaas_webhook_inbox {
  event_id                    String                       @id
  event_type                  String
  provider_created_at         String?
  kind                        String
  resource                    Json?                        @db.JsonB
  status                      String
  reason                      String?
  received_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  reconciliation_attempted_at DateTime?                    @db.Timestamptz(6)
  initial_payment             onboarding_initial_payments?
  paid_access_payment         onboarding_paid_access_payments? @relation("paid_access_source_event")

  @@index([status, received_at], map: "asaas_webhook_inbox_pending_idx")
  @@index([kind, reconciliation_attempted_at, received_at], map: "asaas_webhook_inbox_queue_idx", where: raw("((kind = 'payment'::text) AND (status = ANY (ARRAY['pending_reconciliation'::text, 'reconciled'::text])))"))
}

model onboarding_initial_payments {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cadastro_id              String                      @unique(map: "onboarding_initial_payments_cadastro_uk") @db.Uuid
  checkout_attempt_id      String                      @unique(map: "onboarding_initial_payments_attempt_uk") @db.Uuid
  source_event_id          String                      @unique(map: "onboarding_initial_payments_event_uk")
  payment_id               String                      @unique(map: "onboarding_initial_payments_payment_uk")
  subscription_id          String                      @unique(map: "onboarding_initial_payments_subscription_uk")
  checkout_id              String
  payment_status           String
  payment_value            Decimal                     @db.Decimal(10, 2)
  payment_billing_type      String
  subscription_status       String
  subscription_value       Decimal                     @db.Decimal(10, 2)
  cycle                    String
  state                    String                      @default("paid_pending_activation")
  observed_at              DateTime                    @db.Timestamptz(6)
  activation_invitation_id String?                     @unique(map: "onboarding_initial_payments_activation_invitation_uk") @db.Uuid
  cadastro                 cadastros                   @relation(fields: [cadastro_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_initial_payments_cadastro_fk")
  checkout_attempt         onboarding_checkout_attempts @relation(fields: [checkout_attempt_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_initial_payments_attempt_fk")
  source_event             asaas_webhook_inbox         @relation(fields: [source_event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_initial_payments_event_fk")
  activation_invitation    onboarding_invitations?     @relation("onboarding_initial_payment_activation", fields: [activation_invitation_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "onboarding_initial_payments_activation_invitation_fk")
  paid_access_payments     onboarding_paid_access_payments[]

  @@index([state, observed_at], map: "onboarding_initial_payments_state_idx")
}

model onboarding_paid_access_payments {
  payment_id         String                      @id
  initial_payment_id String                      @db.Uuid
  source_event_id    String                      @unique
  confirmed_date     DateTime                    @db.Date
  starts_at          DateTime                    @db.Timestamptz(6)
  ends_at            DateTime                    @db.Timestamptz(6)
  created_at         DateTime                    @default(now()) @db.Timestamptz(6)
  initial_payment    onboarding_initial_payments @relation(fields: [initial_payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_paid_access_payments_initial_fk")
  source_event       asaas_webhook_inbox         @relation("paid_access_source_event", fields: [source_event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_paid_access_payments_event_fk")

  @@index([initial_payment_id, confirmed_date, payment_id], map: "onboarding_paid_access_payments_owner_date_idx")
  @@map("onboarding_paid_access_payments")
}

model onboarding_activation_intents {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitation_id     String                       @unique(map: "onboarding_activation_intents_invitation_uk") @db.Uuid
  cadastro_id       String                       @unique(map: "onboarding_activation_intents_cadastro_uk") @db.Uuid
  state_hash        String                       @unique(map: "onboarding_activation_intents_state_hash_uk")
  browser_token_hash String                      @unique(map: "onboarding_activation_intents_browser_hash_uk")
  nonce             String
  encrypted_verifier Bytes?                      @db.ByteA
  issuer            String
  client_id         String
  redirect_uri      String
  expires_at        DateTime                     @db.Timestamptz(6)
  state             String                       @default("pending")
  consumed_at       DateTime?                    @db.Timestamptz(6)
  created_at        DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                     @default(now()) @db.Timestamptz(6)
  cadastro          cadastros                    @relation(fields: [cadastro_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_activation_intents_cadastro_fk")
  invitation        onboarding_invitations       @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_activation_intents_invitation_fk")
  binding           onboarding_identity_bindings?

  @@index([state, expires_at], map: "onboarding_activation_intents_state_idx")
}

model onboarding_identity_bindings {
  cadastro_id String                        @id @db.Uuid
  user_id     BigInt                        @unique(map: "onboarding_identity_bindings_user_uk")
  intent_id   String                        @unique(map: "onboarding_identity_bindings_intent_uk") @db.Uuid
  issuer      String
  subject     String
  bound_at    DateTime                      @default(now()) @db.Timestamptz(6)
  cadastro    cadastros                     @relation(fields: [cadastro_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_identity_bindings_cadastro_fk")
  user        users                         @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "onboarding_identity_bindings_user_fk")
  intent      onboarding_activation_intents @relation(fields: [intent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "onboarding_identity_bindings_intent_fk")

  @@unique([issuer, subject], map: "onboarding_identity_bindings_issuer_subject_uk")
}

model collection_runs {
  id                         BigInt                       @id @default(autoincrement())
  source_id                  String
  job                        String
  started_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  finished_at                DateTime?                    @db.Timestamptz(6)
  ok                         Boolean?
  fetched                    Int                          @default(0)
  upserted                   Int                          @default(0)
  skipped                    Int                          @default(0)
  error                      String?
  http_status                Int?
  limite                     Int?
  tenant_collection_attempts tenant_collection_attempts[]

  @@index([source_id, started_at(sort: Desc)], map: "collection_runs_src")
}

model discovered_sites {
  domain       String    @id
  auctioneers  Int       @default(1)
  ufs          String[]
  http_status  Int?
  has_lots     Boolean?
  platform     String?
  connector_id String?
  title        String?
  checked_at   DateTime? @db.Timestamptz(6)
  note         String?
  sources      sources?  @relation(fields: [connector_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([has_lots], map: "sites_haslots")
  @@index([platform], map: "sites_platform")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model espera {
  id            BigInt   @id @default(autoincrement())
  email         String
  nome          String?
  interesse     String?
  origem        String   @default("landing")
  consentimento String
  criado_em     DateTime @default(now()) @db.Timestamptz(6)
}

model favorites {
  id         BigInt   @id @default(autoincrement())
  owner_id   BigInt
  lot_id     BigInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  lots       lots     @relation(fields: [lot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([owner_id, lot_id])
  @@index([owner_id], map: "favorites_owner_idx")
}

/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model lots {
  id                BigInt        @id @default(autoincrement())
  source_id         String
  external_id       String
  lot_url           String?
  title_raw         String
  brand             String?
  model             String?
  version           String?
  year_make         Int?
  year_model        Int?
  km                Int?
  color             String?
  fuel              String?
  plate_masked      String?
  doc_type          String?
  closing_model     String        @default("pregao_em_horario")
  auction_start_utc DateTime?     @db.Timestamptz(6)
  auction_end_utc   DateTime?     @db.Timestamptz(6)
  source_tz         String?
  status            String        @default("sem_data")
  current_bid       Decimal?      @db.Decimal(14, 2)
  min_bid           Decimal?      @db.Decimal(14, 2)
  bid_increment     Decimal?      @db.Decimal(14, 2)
  appraisal         Decimal?      @db.Decimal(14, 2)
  fees_pct          Decimal?      @db.Decimal(6, 3)
  fees_amount       Decimal?      @db.Decimal(14, 2)
  auctioneer_name   String?
  auctioneer_reg    String?
  seller_name       String?
  seller_type       String?
  yard              String?
  city              String?
  state             String?
  lat               Float?
  lon               Float?
  photos            Json          @default("[]")
  photo_count       Int           @default(0)
  financeable       Boolean?
  has_report        Boolean?
  raw               Json?
  search_text       String        @default("")
  first_seen_at     DateTime      @default(now()) @db.Timestamptz(6)
  collected_at      DateTime      @default(now()) @db.Timestamptz(6)
  bid_suspect       Boolean       @default(false)
  asset_type        String        @default("veiculo")
  vehicle_type      String?
  source_category   String?
  property_type     String?
  city_key          String?
  title_display     String?
  closed_reason     String?
  closed_at         DateTime?     @db.Timestamptz(6)
  verified_at       DateTime?     @db.Timestamptz(6)
  verify_result     String?
  verify_fails      Int           @default(0)
  alert_hits        alert_hits[]
  bid_history       bid_history[]
  favorites         favorites[]
  sources           sources       @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([source_id, external_id])
  @@index([asset_type], map: "lots_asset_type")
  @@index([source_id, collected_at], map: "lots_ausencia_idx", where: raw("(status = ANY (ARRAY['aberto'::text, 'agendado'::text]))"))
  @@index([bid_suspect], map: "lots_bid_suspect")
  @@index([brand, model], map: "lots_brand_model")
  @@index([auction_start_utc], map: "lots_encerrar_pregao_idx", where: raw("((status = ANY (ARRAY['aberto'::text, 'agendado'::text])) AND (closing_model <> 'timer_por_lote'::text))"))
  @@index([auction_end_utc], map: "lots_encerrar_timer_idx", where: raw("((status = ANY (ARRAY['aberto'::text, 'agendado'::text])) AND (closing_model = 'timer_por_lote'::text))"))
  @@index([auction_end_utc], map: "lots_end_at")
  @@index([current_bid], map: "lots_price")
  @@index([property_type], map: "lots_property_type", where: raw("(property_type IS NOT NULL)"))
  @@index([search_text(ops: raw("gin_trgm_ops"))], map: "lots_search_trgm", type: Gin)
  @@index([auction_start_utc], map: "lots_start_at")
  @@index([state], map: "lots_state")
  @@index([status], map: "lots_status")
  @@index([state, city_key], map: "lots_uf_cidade", where: raw("(city_key IS NOT NULL)"))
  @@index([vehicle_type], map: "lots_vehicle_type")
  @@index([source_id, verified_at], map: "lots_verificar_idx", where: raw("(status = ANY (ARRAY['aberto'::text, 'agendado'::text]))"))
}

model push_subscriptions {
  endpoint   String   @id
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  failures   Int      @default(0)
  owner_id   BigInt?
  users      users?   @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([owner_id], map: "push_subscriptions_owner_idx")
}

model saved_searches {
  id         BigInt   @id @default(autoincrement())
  label      String
  query      Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
  owner_id   BigInt?
  users      users?   @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([owner_id], map: "saved_searches_owner_idx")
}

model sources {
  id                         String                       @id
  name                       String
  platform                   String?
  method                     String
  tier                       Int                          @default(1) @db.SmallInt
  enabled                    Boolean                      @default(true)
  site_url                   String?
  notes                      String?
  discovered_sites           discovered_sites[]
  lots                       lots[]
  tenant_collection_attempts tenant_collection_attempts[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tenant_collection_attempts {
  id              BigInt           @id @default(autoincrement())
  run_id          BigInt?
  source_id       String
  domain          String
  origin          String
  job_id          String?
  scheduled_at    DateTime?        @db.Timestamptz(6)
  started_at      DateTime         @default(now()) @db.Timestamptz(6)
  finished_at     DateTime?        @db.Timestamptz(6)
  state           String           @default("running")
  fetched         Int              @default(0)
  skipped         Int              @default(0)
  returned        Int              @default(0)
  http_status     Int?
  http_responses  Int              @default(0)
  error_kind      String?
  collection_runs collection_runs? @relation(fields: [run_id], references: [id], onUpdate: NoAction)
  sources         sources          @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([source_id, domain, started_at(sort: Desc)], map: "tenant_attempts_source_domain_started_idx")
  @@index([started_at], map: "tenant_attempts_unfinished_idx", where: raw("(state = 'running'::text)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                 BigInt               @id @default(autoincrement())
  sub                String?              @unique(map: "users_sub_uk", where: raw("(sub IS NOT NULL)"))
  email              String?
  nome               String?
  papel              String               @default("comum")
  criado_em          DateTime             @default(now()) @db.Timestamptz(6)
  visto_em           DateTime?            @db.Timestamptz(6)
  alerts             alerts[]
  favorites          favorites[]
  push_subscriptions push_subscriptions[]
  saved_searches     saved_searches[]
  onboarding_identity_bindings onboarding_identity_bindings[]
  onboarding_staging_baseline onboarding_staging_baseline_users?
}

model onboarding_staging_admission {
  id                 Int                               @id
  issuer             String
  initialized_at     DateTime                          @default(now()) @db.Timestamptz(6)
  baseline_initialized Boolean                         @default(true)
  baseline_users     onboarding_staging_baseline_users[]

  @@map("onboarding_staging_admission")
}

model onboarding_staging_baseline_users {
  user_id    BigInt                      @id
  policy_id  Int                         @default(1)
  marked_at  DateTime                    @default(now()) @db.Timestamptz(6)
  user       users                       @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  policy     onboarding_staging_admission @relation(fields: [policy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("onboarding_staging_baseline_users")
}
